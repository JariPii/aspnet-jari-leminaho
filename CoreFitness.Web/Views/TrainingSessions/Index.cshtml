@model IEnumerable<TrainingSessionDTO>


<h2 class='text-center font-header text-5xl mb-10'>Our Classes</h2>

<div class='flex items-center justify-center'>
    <cf-section>
        <div class='flex gap-4'>
            @foreach (var session in Model)
            {
                <div class='shadow-xl p-2 rounded-3xl'>
                    <div class='flex flex-col gap-6 shadow-xl p-4 rounded-3xl'>
                        <div>
                            <h3 class='font-header'>Name</h3>
                            <p>@session.Name</p>
                        </div>
                        <div>
                            <h4 class='font-header'>Description</h4>
                            <p>@session.Description</p>
                        </div>
                        <div>
                            <h5 class='font-header'>Available spots</h5>
                            <p>@session.AvailableSpots</p>
                        </div>

                        <form asp-controller="Booking" asp-action="Book" method="post">
                            <input type="hidden" name='sessionId' value="@session.Id" />
                            <cf-button type="submit" class='self-end'>
                                Book
                            </cf-button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </cf-section>
</div>